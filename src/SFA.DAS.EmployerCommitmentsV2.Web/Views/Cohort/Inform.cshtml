@using SFA.DAS.EmployerCommitmentsV2.Web.Extensions
@model SFA.DAS.EmployerCommitmentsV2.Web.Models.Cohort.InformViewModel

@{
    ViewData["Title"] = "How to add learners";
    ViewBag.GaData.Vpv = "/apprentices/inform";

    var viewModel = new SFA.DAS.EmployerCommitmentsV2.Web.Models.Cohort.HowToAddLearnersViewModel
    {
        AccountHashedId = Model.AccountHashedId,
        IsLevyFunded = Model.IsLevyFunded,
        ApprenticeshipSessionKey = Model.ApprenticeshipSessionKey,
        ContinueAction = "SelectLegalEntity"
    };
}

<partial name="_HowToAddLearners" model="viewModel" />

@section Back
{
    <a id="back-link" class="govuk-back-link" href="@Url.Action("Index", "Home", new {Model.AccountHashedId})">Back to Learners</a>
}